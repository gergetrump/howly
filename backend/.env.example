PORT=3000
APP_TIMEZONE=Europe/Berlin
MONGO_URI=mongodb://127.0.0.1:27017/howly
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
SERVER_BASE_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:5173

# Production only. docker-compose.prod.yml sets TRUST_PROXY and the public URLs.
# CORS_ORIGINS is a comma-separated list for extra browser origins.
TRUST_PROXY=false
CORS_ORIGINS=

# Email is disabled locally unless you set DISABLE_EMAIL_SENDING=false
DISABLE_EMAIL_SENDING=true
DEVELOPER_FEEDBACK_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Howly <noreply@localhost>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

MODERATION_API_KEY=
MODERATION_MODEL=omni-moderation-latest
